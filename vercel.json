{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/strategy-lab",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/cs-:slug",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/StartBox_Adhyava_CaseStudy",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/hero-reel.mp4",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/brand-diagnosis",
      "destination": "/how-we-work#diagnosis",
      "permanent": true
    },
    {
      "source": "/insights/google-business-profile-checklist-india",
      "destination": "/insights/google-business-profile-checklist",
      "permanent": true
    },
    {
      "source": "/business-audit",
      "destination": "/how-we-work#diagnosis",
      "permanent": true
    },
    {
      "source": "/services/look-trustworthy",
      "destination": "/services#digital-presence",
      "permanent": true
    },
    {
      "source": "/services/sell-online",
      "destination": "/services#go-to-market",
      "permanent": true
    },
    {
      "source": "/services/get-more-customers",
      "destination": "/services#campaign-manager",
      "permanent": true
    },
    {
      "source": "/services/content-and-personal-brand",
      "destination": "/services#personal-branding",
      "permanent": true
    },
    {
      "source": "/services/run-the-business-better",
      "destination": "/services#marketing-partner",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/meet",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/collaborate",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/startbox-ventures.vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vcard; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"StartBox-Ventures.vcf\""
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
